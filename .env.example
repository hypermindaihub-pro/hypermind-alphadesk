NEXT_PUBLIC_APP_NAME="Hypermind AlphaDesk"

# Private access gate. Use long random values in real deployments.
ALPHADESK_AUTH_REQUIRED=true
ALPHADESK_ACCESS_CODE=
ALPHADESK_ADMIN_CODE=
ALPHADESK_SESSION_SECRET=

# Optional server-side JSONL audit log folder name under data/alphadesk-audit/.
# Leave blank for Vercel/serverless deployments unless the target provides durable writable storage.
ALPHADESK_AUDIT_LOG_DIR=

# Safe defaults
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
MEXC_ORDER_TEST_MODE=true
ALLOW_MAINNET_LIVE_TRADING=false
EMERGENCY_STOP=false
NO_TRADE_MODE=false

# Product-specific live flags stay false unless deliberately enabled.
PRODUCT_SPOT_LIVE_ENABLED=false
PRODUCT_DERIVATIVES_LIVE_ENABLED=false

# Server-only secrets. Leave blank for local paper trading.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_REQUEST_TIMEOUT_MS=8000

# Explicit live validation. With MEXC_ORDER_TEST_MODE=true this validates against MEXC /api/v3/order/test.
# Set MEXC_ORDER_TEST_MODE=false only for real MEXC mainnet orders after a separate launch review.
# Keep false unless you are intentionally running `npm run test:mexc-live`.
ALPHADESK_ENABLE_LIVE_TESTNET_E2E=false

# Risk defaults
RISK_MAX_POSITION_USD=2500
RISK_MAX_LEVERAGE=2
RISK_MAX_DAILY_DRAWDOWN_PCT=3
RISK_MIN_CONFIDENCE=0.62

# Cost controls
OPENAI_DAILY_BUDGET_USD=5
OPENAI_HARD_STOP_USD=8
